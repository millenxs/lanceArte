# QA Agent 团队共享环境值——可提交到 git。
# 含测试环境凭证（账号/MySQL），仅 LLM API Key 等真实密钥放在 local/.env。

# ── LLM ──
# LLM 网关地址（无内置默认，需自行配置）
QA_AGENT_LLM_BASE_URL=

# ── 服务地址 ──
# web 服务地址
QA_WEB_BASE_URL=https://lancearte.vercel.app
# api 服务地址
QA_API_BASE_URL=https://lancearte.vercel.app/api

# ── 账号凭证 ──
# 测试账号用户名
QA_USER_USERNAME=
# 测试账号密码
QA_USER_PASSWORD=

# ── MySQL ──
# MySQL 主机
QA_MYSQL_HOST=
# MySQL 端口
QA_MYSQL_PORT=3306
# MySQL 数据库名
QA_MYSQL_DATABASE=
# MySQL 用户名
QA_MYSQL_USER=
# MySQL 密码
QA_MYSQL_PASS=
